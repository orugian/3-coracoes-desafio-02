{
  "title": "CustomerInternal",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "destinationLabel": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "incoterm": {
      "type": "string"
    },
    "paymentCode": {
      "type": "string"
    },
    "paymentTerms": {
      "type": "string"
    },
    "priceList": {
      "type": "string"
    },
    "plant": {
      "type": "string"
    },
    "plantName": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "contactName": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "pt",
        "es",
        "en"
      ]
    },
    "mixedPallet": {
      "type": "boolean"
    },
    "country": {
      "type": [
        "string",
        "null"
      ]
    },
    "autoApprove": {
      "type": "boolean"
    },
    "isDemo": {
      "type": "boolean"
    },
    "restrictedMaterials": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "code",
    "slug",
    "name",
    "destinationLabel",
    "currency",
    "incoterm",
    "paymentCode",
    "paymentTerms",
    "priceList",
    "plant",
    "plantName",
    "branch",
    "contactName",
    "language",
    "mixedPallet",
    "country",
    "autoApprove",
    "isDemo",
    "restrictedMaterials"
  ],
  "additionalProperties": false
}
