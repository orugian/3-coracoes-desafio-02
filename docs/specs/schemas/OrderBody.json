{
  "title": "OrderBody",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "customerCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "header": {
      "type": "object",
      "properties": {
        "vehicleId": {
          "type": "string",
          "enum": [
            "carreta_padrao",
            "container_40",
            "container_20"
          ]
        },
        "loadMode": {
          "type": "string",
          "enum": [
            "PALLETIZED",
            "FLOOR"
          ]
        },
        "reference": {
          "default": "",
          "type": "string",
          "maxLength": 30,
          "pattern": "^[^\\p{Cc}]*$"
        },
        "loadingDate": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "vehicleId",
        "loadMode"
      ]
    },
    "lines": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "material": {
            "type": "string",
            "pattern": "^\\d{8}$"
          },
          "boxes": {
            "type": "number",
            "minimum": 1,
            "maximum": 100000
          }
        },
        "required": [
          "material",
          "boxes"
        ]
      }
    }
  },
  "required": [
    "customerCode",
    "header",
    "lines"
  ]
}
