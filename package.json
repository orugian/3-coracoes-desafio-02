{
  "name": "pedido-sem-fronteiras",
  "version": "0.1.0",
  "private": true,
  "description": "Pedido sem Fronteiras (3corações, Desafio 02): API, motor e seed do corte",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "imports": {
    "#engine": "./packages/engine/src/index.ts",
    "#contracts": "./packages/contracts/src/index.ts",
    "#server/*": "./server/src/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/src/main.ts",
    "test": "tsc --noEmit && node --test \"**/*.test.ts\"",
    "db:migrate": "node --env-file-if-exists=.env scripts/db_migrate.ts",
    "db:seed": "node --env-file-if-exists=.env scripts/db_seed.ts",
    "extract": "node scripts/extract.ts",
    "fixtures:piloto": "node scripts/extrair_piloto.ts",
    "contracts:schema": "node scripts/contracts_schema.ts",
    "user:unlock": "node --env-file-if-exists=.env scripts/user_unlock.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "happy-dom": "21.0.1",
    "typescript": "5.9.3"
  }
}
