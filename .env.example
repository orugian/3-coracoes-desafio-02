# Copie para .env e preencha só o que precisar (docs/specs/04-api.md, "Configuração"). Variável vazia = padrão.
# Porta HTTP (padrão 3000)
PORT=
# Assinatura HS256 do token de sessão, >= 32 bytes; obrigatória fora dos testes
SESSION_SECRET=
# Diretório do PGlite (padrão ./storage/pglite)
DATA_DIR=
# Se definida, usa PostgreSQL via pg em vez do PGlite
DATABASE_URL=
# true atrás de HTTPS (padrão false)
COOKIE_SECURE=
# Só o seed (docs/specs/03-seed.md): mesma senha para todos os usuários de demonstração
SEED_PASSWORD=
