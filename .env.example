# Variáveis de ambiente da Xica. Na Vercel: Project → Settings → Environment Variables.
# Para rodar local com `vercel dev`, copie para .env (o .env nunca vai para o Git).

# Obrigatória: chave da OpenRouter (https://openrouter.ai/keys). Sem ela, o chat usa o motor de respostas embutido.
OPENROUTER_API_KEY=

# Opcionais
OPENROUTER_MODEL=xiaomi/mimo-v2.6-flash
# Modelos de reserva, separados por vírgula, usados se o principal falhar. Vazio = sem reserva.
OPENROUTER_FALLBACK_MODELS=anthropic/claude-haiku-5.5
# Perguntas por minuto por IP e teto diário (valem por instância da função)
XICA_RATE_PER_MIN=20
XICA_DAILY_CAP=1000
